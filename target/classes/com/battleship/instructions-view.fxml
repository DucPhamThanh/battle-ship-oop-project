<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<StackPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.battleship.MenuController">
   <children>
      <ImageView fitHeight="700.0" fitWidth="1000.0" pickOnBounds="true">
         <image>
            <Image url="@assets/menu_bg.png" />
         </image>
      </ImageView>
      <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: rgba(15, 23, 42, 0.7); -fx-background-radius: 20;">
         <StackPane.margin>
            <Insets bottom="50.0" left="100.0" right="100.0" top="50.0" />
         </StackPane.margin>
         <children>
            <Label styleClass="menu-title" text="HOW TO PLAY">
               <font>
                  <Font name="Impact" size="48.0" />
               </font>
            </Label>
            <VBox spacing="15.0" alignment="TOP_LEFT">
               <padding>
                  <Insets left="50.0" right="50.0" top="20.0" bottom="20.0"/>
               </padding>
               <children>
                  <Label styleClass="instruction-text" text="1. Đặt tàu: Chọn các ô liên tiếp để đặt 5 loại tàu của bạn." wrapText="true" />
                  <Label styleClass="instruction-text" text="2. Chiến đấu: Click vào bảng đối phương để bắn." wrapText="true" />
                  <Label styleClass="instruction-text" text="3. Mục tiêu: Đánh chìm toàn bộ hạm đội địch trước khi địch tiêu diệt bạn." wrapText="true" />
                  <Label styleClass="instruction-text" text="4. Màu sắc: Đỏ là trúng, Xanh đậm là trượt, Đỏ đậm là tàu đã chìm." wrapText="true" />
                  <Label styleClass="instruction-text" text="5. Chiến thuật: Hãy quan sát kỹ các vị trí đã bắn để đoán hướng đi của tàu địch." wrapText="true" />
               </children>
            </VBox>
            <Button mnemonicParsing="false" onAction="#onBackToMenu" styleClass="menu-button-alt" text="QUAY LẠI" />
         </children>
      </VBox>
   </children>
</StackPane>
